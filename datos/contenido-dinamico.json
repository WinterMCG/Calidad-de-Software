  "preguntas_frecuentes": [
    {
      "id": 1,
      "pregunta": "¿Cuál es la diferencia entre verificación y validación?",
      "respuesta": "Verificación: ¿Construimos el producto correctamente? (cumple especificaciones). Validación: ¿Construimos el producto correcto? (satisface necesidades del cliente)."
    },
    {
      "id": 2,
      "pregunta": "¿Qué nivel de CMMI es el más común?",
      "respuesta": "El nivel 3 (Definido) es el más común entre organizaciones que buscan certificación, ya que implica procesos estandarizados en toda la organización."
    },
    {
      "id": 3,
      "pregunta": "¿Cuántos usuarios se necesitan para una prueba de usabilidad?",
      "respuesta": "Jakob Nielsen demostró que con 5 usuarios se encuentra aproximadamente el 85% de los problemas de usabilidad. 15 usuarios alcanzan el 100%."
    },
    {
      "id": 4,
      "pregunta": "¿Qué es el 'Shift Left Testing'?",
      "respuesta": "Es la práctica de mover las pruebas hacia la izquierda en el ciclo de vida del desarrollo (a etapas más tempranas) para detectar errores más baratos."
    },
    {
      "id": 5,
      "pregunta": "¿Qué relación hay entre QC y QA?",
      "respuesta": "QA (Aseguramiento) se enfoca en prevenir defectos mediante procesos. QC (Control) se enfoca en detectar defectos mediante pruebas. Ambos son necesarios."
    }
